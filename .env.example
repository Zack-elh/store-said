# Environment variables for store-said (JaLaba)
# Copy this file to .env and fill in the values you need.
# None of these are consumed by the app yet — the site currently ships as a
# static export with hardcoded content values.

# Public base URL used for SEO / Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://jalaba.com

# Contact details surfaced in the UI (see contexts/LanguageContext.tsx)
NEXT_PUBLIC_CONTACT_EMAIL=contact@jalaba.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+212 600 000 000

# Analytics / third-party keys (optional)
# NEXT_PUBLIC_GA_ID=
